{
  "name": "posit",
  "version": "1.0.0",
  "type": "module",
  "description": "An experimental, interactive diagramming engine that aims to support a PlantUML-compatible representation.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "test": "vitest --run --pool=forks -c vitest.basic.config.ts",
    "test:all": "vitest --run --pool=forks",
    "build": "vite build",
    "test:plantuml_sequence": "vitest --run --pool=forks -c vitest.coverage.config.ts test_scripts/syntax-coverage.test.ts",
    "test:plantuml_class": "vitest --run --pool=forks -c vitest.coverage.config.ts test_scripts/class-syntax-coverage.test.ts",
    "test:plantuml_deployment": "vitest --run --pool=forks -c vitest.coverage.config.ts test_scripts/deployment-syntax-coverage.test.ts",
    "test:mermaid_sequence": "vitest --run --pool=forks -c vitest.coverage.config.ts test_scripts/mermaid-sequence-coverage.test.ts",
    "test:mermaid_class": "vitest --run --pool=forks -c vitest.coverage.config.ts test_scripts/mermaid-class-coverage.test.ts",
    "test:mermaid_flowchart": "vitest --run --pool=forks -c vitest.coverage.config.ts test_scripts/mermaid-flowchart-coverage.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chevrotain": "^11.0.3",
    "konva": "^10.2.1"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.19.37",
    "canvas": "^3.2.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^1.6.1"
  }
}
