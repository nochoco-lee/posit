sequenceDiagram
    title User Login

    actor User
    participant Auth as Auth API
    participant DB as Users DB

    User->>Auth: POST /login {email, password}
    activate Auth
    Auth->>DB: findUser(email)
    activate DB
    DB-->>Auth: user record
    deactivate DB

    Auth->>Auth: verifyPassword()
    alt password valid
        Auth-->>User: 200 OK {token}
    else invalid credentials
        Auth-->>User: 401 Unauthorized
    end
    deactivate Auth
