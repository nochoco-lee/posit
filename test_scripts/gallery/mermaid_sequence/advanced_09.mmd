sequenceDiagram
    title Refund and Return Flow

    actor User
    participant Order as Order API
    participant Pay as Payment API
    participant Inv as Inventory API
    participant Notif as Notification API

    rect rgb(240, 248, 255)
        Note over User,Notif: Request Return
        User->>Order: POST /orders/{id}/return {reason}
        activate Order
        Order->>Order: validateReturnWindow()
        Note right: Check if within<br/>30-day return window

        Order->>Pay: refund(orderId, amount)
        activate Pay
        alt refund successful
            Pay-->>Order: refundId
            deactivate Pay

            Order->>Inv: restockItems(items[])
            activate Inv
            Inv-->>Order: restocked
            deactivate Inv

            Order->>Notif: sendReturnConfirmation(userId, orderId)
            activate Notif
            Notif-->>Order: sent
            deactivate Notif

            Order-->>User: 200 OK {refundId, status: "processing"}
        else refund failed
            Pay-->>Order: error
            deactivate Pay

            Order-->>User: 500 Internal Server Error
        end
        deactivate Order
    end

    rect rgb(255, 248, 240)
        Note over Pay,Notif: Refund Completed (Webhook)
        Pay->>Order: POST /webhooks/refund {refundId, status: "completed"}
        activate Order
        Order->>Order: updateStatus("REFUNDED")
        Order->>Notif: sendRefundReceipt(userId, refundId)
        activate Notif
        Notif-->>Order: sent
        deactivate Notif
        deactivate Order
    end
