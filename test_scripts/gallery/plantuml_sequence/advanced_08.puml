@startuml
title Microservice Order Orchestration

actor       User         as user
participant "API Gateway" as gw
participant "Order Svc"   as order
participant "Cart Svc"    as cart
participant "Inventory Svc" as inv
participant "Payment Svc" as pay
participant "Notification Svc" as notif
participant "Shipping Svc" as ship

user -> gw : POST /checkout
activate gw
  gw -> order : createOrder(cartId, userId)
  activate order

  order -> cart : getCart(cartId)
  activate cart
  cart --> order : items[]
  deactivate cart

  order -> inv : reserveItems(items[])
  activate inv
  inv --> order : reservationId
  deactivate inv

  order -> pay : processPayment(userId, amount)
  activate pay
  pay --> order : paymentId
  deactivate pay

  order -> ship : createShipment(address, items[])
  activate ship
  ship --> order : trackingNumber
  deactivate ship

  order -> notif : sendConfirmation(userId, orderId, tracking)
  activate notif
  notif --> order : sent
  deactivate notif

  order --> gw : 201 {orderId, tracking}
  deactivate order

  gw --> user : 201 Created
deactivate gw
@enduml
