@startuml
title Order Processing with Inventory Check

actor       User        as user
participant "Order API"  as order
participant "Inventory API" as inv
participant "Payment API" as pay
participant "Notification API" as notif
database    "Orders DB"  as db

user -> order : POST /orders {cartId, address}
activate order

  order -> inv : checkStock(cartItems)
  activate inv
  inv --> order : inStock
  deactivate inv

  order -> inv : reserveItems(cartItems)
  activate inv
  alt reservation successful
    inv --> order : reservationId
    deactivate inv

    order -> pay : charge(userId, total)
    activate pay
    alt payment successful
      pay --> order : paymentId
      deactivate pay

      order -> db : createOrder(status: CONFIRMED)
      activate db
      db --> order : orderId
      deactivate db

      order -> notif : sendOrderConfirmation(userId, orderId)
      activate notif
      notif --> order : sent
      deactivate notif

      order --> user : 201 Created {orderId}
    else payment failed
      pay --> order : error
      deactivate pay

      order -> inv : releaseReservation(cartItems)
      order --> user : 402 Payment Required
    end
  else out of stock
    inv --> order : error
    deactivate inv

    order --> user : 409 Conflict {unavailable: [...]}
  end
deactivate order
@enduml
