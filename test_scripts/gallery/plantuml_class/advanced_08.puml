@startuml
title Full Domain Model

hide empty members

package "Auth" {
  class User {
    -id: Long
    -name: String
    -email: String
    -passwordHash: String
    --
    +verifyPassword(pw: String): Boolean
    +hasRole(name: String): Boolean
  }
  class Role {
    -name: String
    -permissions: Set<String>
    --
    +hasPermission(perm: String): Boolean
  }
}

package "Catalog" {
  class Product {
    -id: Long
    -name: String
    -price: Money
    -stock: Int
    -status: ProductStatus
    --
    +isAvailable(): Boolean
    +reduceStock(qty: Int): void
    +getDiscountPrice(pct: Double): Money
  }
  class Category {
    -id: Long
    -name: String
    -parent: Category
    --
    +getAncestors(): List<Category>
    +getChildren(): List<Category>
  }
  class Money {
    -amount: BigDecimal
    -currency: String
    --
    +add(other: Money): Money
    +multiply(qty: Int): Money
    +format(): String
  }
  enum ProductStatus { DRAFT, ACTIVE, ARCHIVED }
}

package "Order" {
  class Order {
    -id: Long
    -status: OrderStatus
    -total: Money
    -createdAt: DateTime
    -updatedAt: DateTime
    --
    +submit(): void
    +cancel(): void
    +markShipped(tracking: String): void
    +deliver(): void
  }
  class OrderItem {
    -quantity: Int
    -unitPrice: Money
    --
    +getSubtotal(): Money
    +updateQuantity(qty: Int): void
  }
  enum OrderStatus { PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED }
}

package "Payment" {
  class Payment {
    -id: String
    -amount: Money
    -method: String
    -status: PaymentStatus
    --
    +confirm(): void
    +fail(reason: String): void
  }
  class Refund {
    -id: String
    -paymentId: String
    -amount: Money
    --
    +process(): void
    +getStatus(): String
  }
  enum PaymentStatus { PENDING, COMPLETED, FAILED, REFUNDED }
}

package "Shipping" {
  class Shipment {
    -trackingNumber: String
    -carrier: String
    -status: ShipmentStatus
    -estimatedDelivery: Date
    --
    +updateStatus(status: String): void
    +getTrackingUrl(): String
  }
  class Address {
    -street: String
    -city: String
    -state: String
    -zip: String
    -country: String
    --
    +getFullAddress(): String
    +validate(): Boolean
  }
  enum ShipmentStatus { PREPARING, IN_TRANSIT, DELIVERED, RETURNED }
}

User "1" -- "*" Order : places >
User "1" -- "*" Role : has >
Order "1" *-- "1..*" OrderItem : contains >
Order "1" -- "1" Shipment : ships via >
Order "1" -- "0..1" Payment : paid by >
Product "1" -- "*" OrderItem : references >
Product "*" -- "*" Category : categorized >
Shipment --> Address : delivers to >
Payment "1" -- "0..*" Refund : may have >
Order --> OrderStatus
Payment --> PaymentStatus
Shipment --> ShipmentStatus
Product --> ProductStatus
@enduml
