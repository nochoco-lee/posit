@startuml
title Full Domain Model

package "Auth" {
  class User {
    -id: Long
    -name: String
    -email: String
    -passwordHash: String
    +verifyPassword(pw: String): Boolean
  }
  class Role {
    -name: String
    -permissions: List<String>
  }
}

package "Catalog" {
  class Product {
    -id: Long
    -name: String
    -price: Money
    -stock: Int
    -status: ProductStatus
  }
  class Category {
    -id: Long
    -name: String
    -parent: Category
  }
  class Money {
    -amount: BigDecimal
    -currency: String
  }
}

package "Order" {
  class Order {
    -id: Long
    -status: OrderStatus
    -total: Money
    -createdAt: DateTime
  }
  class OrderItem {
    -quantity: Int
    -unitPrice: Money
  }
}

package "Payment" {
  class Payment {
    -id: String
    -amount: Money
    -method: String
    -status: PaymentStatus
  }
  class Refund {
    -id: String
    -paymentId: String
    -amount: Money
  }
}

package "Shipping" {
  class Shipment {
    -trackingNumber: String
    -carrier: String
    -status: ShipmentStatus
    -estimatedDelivery: Date
  }
  class Address {
    -street: String
    -city: String
    -state: String
    -zip: String
    -country: String
  }
}

User "1" -- "*" Order : places >
User "1" -- "*" Role : has >
Order "1" *-- "1..*" OrderItem : contains >
Order "1" -- "1" Shipment : ships via >
Order "1" -- "0..1" Payment : paid by >
Product "1" -- "*" OrderItem : references >
Product "*" -- "*" Category : categorized >
Shipment --> Address : delivers to >
Payment "1" -- "0..*" Refund : may have >
@enduml
