@startuml
title Payment Strategy Pattern

hide empty members

package "Payment Module" {
  interface PaymentStrategy {
    +pay(amount: Money): PaymentResult
    +refund(transactionId: String): RefundResult
    +supports(currency: String): Boolean
    +getProviderName(): String
  }

  class CreditCardPayment implements PaymentStrategy {
    -cardNumber: String
    -expiry: String
    -cvv: String
    +pay(amount: Money): PaymentResult
    +refund(transactionId: String): RefundResult
    +supports(currency: String): Boolean
    +getProviderName(): String
  }

  class PayPalPayment implements PaymentStrategy {
    -email: String
    -clientId: String
    +pay(amount: Money): PaymentResult
    +refund(transactionId: String): RefundResult
    +supports(currency: String): Boolean
    +getProviderName(): String
  }

  class CryptoPayment implements PaymentStrategy {
    -walletAddress: String
    -network: String
    +pay(amount: Money): PaymentResult
    +refund(transactionId: String): RefundResult
    +supports(currency: String): Boolean
    +getProviderName(): String
  }

  class PaymentContext {
    -strategy: PaymentStrategy
    -history: List<PaymentResult>
    +setStrategy(s: PaymentStrategy): void
    +processPayment(amount: Money): PaymentResult
    +processRefund(txnId: String): RefundResult
    +getHistory(): List<PaymentResult>
  }

  class PaymentResult {
    -success: Boolean
    -transactionId: String
    -message: String
    -timestamp: DateTime
  }

  class RefundResult {
    -success: Boolean
    -refundId: String
    -message: String
  }
}

PaymentContext --> PaymentStrategy : uses >
PaymentStrategy ..> PaymentResult
PaymentStrategy ..> RefundResult
@enduml
