@startuml
title Order and OrderItem

hide empty members

package "Order Module" {
  class Order {
    -id: Long
    -userId: Long
    -items: List<OrderItem>
    -status: OrderStatus
    -total: Money
    -createdAt: DateTime
    -updatedAt: DateTime
    --
    +addItem(product: Product, qty: Int): void
    +removeItem(productId: Long): void
    +getTotal(): Money
    +submit(): void
    +cancel(): void
    +markShipped(tracking: String): void
    +deliver(): void
  }

  class OrderItem {
    -id: Long
    -product: Product
    -quantity: Int
    -unitPrice: Money
    --
    +getSubtotal(): Money
    +updateQuantity(qty: Int): void
  }

  enum OrderStatus {
    PENDING
    CONFIRMED
    PROCESSING
    SHIPPED
    DELIVERED
    CANCELLED
    REFUNDED
  }

  class Money {
    -amount: BigDecimal
    -currency: String
    +add(other: Money): Money
    +format(): String
  }

  class Product {
    -id: Long
    -name: String
    -price: Money
  }
}

Order "1" *-- "1..*" OrderItem : contains >
Order "1" --> "1" OrderStatus
OrderItem --> Money
OrderItem --> Product
@enduml
