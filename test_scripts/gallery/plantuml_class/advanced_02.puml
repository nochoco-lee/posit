@startuml
title User and Role Hierarchy

class User {
  -id: Long
  -name: String
  -email: String
  +getRoles(): List<Role>
}

abstract class Role {
  #name: String
  +getPermissions(): List<String>
}

class AdminRole extends Role {
  +getPermissions(): List<String>
}

class CustomerRole extends Role {
  +getPermissions(): List<String>
}

class SellerRole extends Role {
  +getPermissions(): List<String>
}

User "1" *-- "*" Role : has >
@enduml
