classDiagram
    title Product Hierarchy

    class Searchable {
        <<interface>>
        +matches(query String) Boolean
        +getRelevanceScore() Double
    }

    class Pricable {
        <<interface>>
        +getPrice() Money
        +applyDiscount(pct Double) Money
        +isOnSale() Boolean
    }

    class Product {
        <<abstract>>
        #Long id
        #String name
        #String description
        #Money price
        #ProductStatus status
        #DateTime createdAt
        +matches(query String) Boolean
        +getPrice() Money
        +isAvailable() Boolean
    }

    class PhysicalProduct {
        -Double weight
        -Dimensions dimensions
        -String shippingClass
        +applyDiscount(pct Double) Money
        +getShippingCost(dist Double) Money
    }

    class DigitalProduct {
        -String downloadUrl
        -Long fileSize
        -String licenseKey
        +applyDiscount(pct Double) Money
        +getDownloadUrl() String
    }

    class ProductStatus {
        <<enumeration>>
        DRAFT
        ACTIVE
        ARCHIVED
        OUT_OF_STOCK
    }

    class Money {
        -BigDecimal amount
        -String currency
        +add(other Money) Money
        +multiply(qty Int) Money
        +format() String
    }

    class Dimensions {
        -Double width
        -Double height
        -Double depth
        +getVolume() Double
    }

    Product ..|> Searchable
    Product ..|> Pricable
    PhysicalProduct --|> Product
    DigitalProduct --|> Product
    Product --> ProductStatus
    Product --> Money
    PhysicalProduct --> Dimensions
