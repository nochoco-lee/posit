classDiagram
    title Complete System Architecture

    class User {
        -Long id
        -String name
        -String email
        -String passwordHash
        -List~Role~ roles
        +verifyPassword(pw String) Boolean
        +hasRole(name String) Boolean
        +getPermissions() Set~String~
    }
    class Role {
        -String name
        -Set~String~ permissions
        +hasPermission(perm String) Boolean
    }
    class Authenticator {
        <<interface>>
        +authenticate(email String, pw String) Token
        +validate(token String) Boolean
        +refresh(token String) Token
    }
    class JwtAuthenticator {
        -String secret
        -Long expiryMs
        -Long refreshExpiryMs
    }

    class Product {
        <<abstract>>
        #Long id
        #String name
        #String description
        #Money price
        #Int stock
        #ProductStatus status
        #DateTime createdAt
        +isAvailable() Boolean
        +reduceStock(qty Int) void
        +getDiscountPrice(pct Double) Money
    }
    class PhysicalProduct {
        -Double weight
        -Dimensions dimensions
        -String shippingClass
        +getShippingCost(dist Double) Money
    }
    class DigitalProduct {
        -String downloadUrl
        -Long fileSize
        -String licenseKey
        +getDownloadUrl() String
    }
    class Category {
        -Long id
        -String name
        -Category parent
        +getAncestors() List~Category~
        +getChildren() List~Category~
    }
    class Money {
        -BigDecimal amount
        -String currency
        +add(other Money) Money
        +multiply(qty Int) Money
        +format() String
    }
    class ProductStatus {
        <<enumeration>>
        DRAFT
        ACTIVE
        ARCHIVED
    }
    class SearchEngine {
        <<interface>>
        +search(query String, filters Map) List~Product~
        +autocomplete(prefix String) List~String~
    }

    class Cart {
        -Long id
        -Long userId
        -Map~Long,CartItem~ items
        -String couponCode
        +addItem(product Product, qty Int) void
        +removeItem(productId Long) void
        +getTotal() Money
        +applyCoupon(code String) Money
        +clear() void
    }
    class CartItem {
        -Product product
        -Int quantity
        -DateTime addedAt
        +getSubtotal() Money
        +updateQuantity(qty Int) void
    }

    class Order {
        -Long id
        -Long userId
        -List~OrderItem~ items
        -OrderStatus status
        -Money total
        -Address shippingAddress
        -DateTime createdAt
        +submit() void
        +cancel() void
        +markShipped(tracking String) void
        +deliver() void
        +getStatusHistory() List~StatusChange~
    }
    class OrderItem {
        -Product product
        -Int quantity
        -Money unitPrice
        +getSubtotal() Money
        +updateQuantity(qty Int) void
    }
    class StatusChange {
        -OrderStatus from
        -OrderStatus to
        -DateTime timestamp
        -String reason
    }
    class OrderStatus {
        <<enumeration>>
        PENDING
        CONFIRMED
        PROCESSING
        SHIPPED
        DELIVERED
        CANCELLED
        REFUNDED
    }

    class PaymentProvider {
        <<interface>>
        +charge(amount Money, token String) Transaction
        +refund(txnId String) Transaction
        +getTransaction(txnId String) Transaction
    }
    class StripeProvider {
        -String apiKey
        -String webhookSecret
    }
    class PayPalProvider {
        -String clientId
        -String secret
    }
    class Transaction {
        -String id
        -Long orderId
        -Money amount
        -TxnStatus status
        -String provider
        -DateTime createdAt
        +confirm() void
        +fail(reason String) void
    }
    class TxnStatus {
        <<enumeration>>
        PENDING
        SUCCESS
        FAILED
        REFUNDED
    }

    class InventoryManager {
        -Long reservationTTL
        -Int lowStockThreshold
        +reserve(orderId Long, items Map~Long,Int~) Reservation
        +confirm(reservationId String) void
        +release(reservationId String) void
        +getStock(productId Long) Int
        +getLowStockProducts() List~Product~
    }
    class Reservation {
        -String id
        -Long orderId
        -Map~Long,Int~ items
        -DateTime expiresAt
        +isExpired() Boolean
        +extend(ttl Long) void
    }

    class NotificationChannel {
        <<interface>>
        +send(userId Long, template String, data Map) void
        +getChannelName() String
    }
    class EmailChannel {
        -String smtpHost
        -String fromAddress
    }
    class PushChannel {
        -String firebaseKey
    }
    class SmsChannel {
        -String twilioSid
        -String twilioToken
    }
    class NotificationService {
        -List~NotificationChannel~ channels
        -TemplateEngine templateEngine
        +notify(userId Long, event String, data Map) void
        +notifyAll(userIds List~Long~, event String, data Map) void
    }

    class ShippingService {
        +createShipment(orderId Long, address Address) Shipment
        +getRates(address Address, weight Double) List~ShippingRate~
        +track(trackingNumber String) ShipmentStatus
        +calculateInsurance(value Double) Money
    }
    class Shipment {
        -String trackingNumber
        -String carrier
        -ShipmentStatus status
        -Date estimatedDelivery
        -Double weight
        +updateStatus(status String) void
        +getTrackingUrl() String
    }
    class Address {
        -String street
        -String city
        -String state
        -String zip
        -String country
        +getFullAddress() String
        +validate() Boolean
        +isResidential() Boolean
    }
    class ShippingRate {
        -String carrier
        -String service
        -Money cost
        -Int days
        +getEstimatedDelivery() Date
    }
    class ShipmentStatus {
        <<enumeration>>
        PREPARING
        PICKED_UP
        IN_TRANSIT
        OUT_FOR_DELIVERY
        DELIVERED
        RETURNED
    }

    User "1" --> "*" Order : places
    User "1" --> "*" Role : has
    User "1" --> "0..1" Cart : owns
    Product "1" --> "*" OrderItem : referenced in
    Product "*" --> "*" Category : in
    Cart "1" *-- "0..*" CartItem : contains
    CartItem --> Product
    Order "1" *-- "1..*" OrderItem : contains
    OrderItem --> Money
    Order --> OrderStatus
    Order "1" --> "0..1" Transaction : paid by
    Order "1" --> "0..1" Shipment : fulfilled by
    Shipment --> Address
    Shipment --> ShipmentStatus
    InventoryManager ..> Reservation
    Reservation --> Order
    NotificationService --> NotificationChannel
